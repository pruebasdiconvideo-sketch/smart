diff --git a/src/main/resources/static/js/ingresos.js b/src/main/resources/static/js/ingresos.js
new file mode 100644
index 0000000..30fb839
--- /dev/null
+++ b/src/main/resources/static/js/ingresos.js
@@ -0,0 +1,639 @@
+/* =====================================================================
+   Smart Power On — Ingreso de materiales contra orden de compra
+   Vista 1: listado de OC · Vista 2: formulario de OC
+   Modal A: agregar/editar material de la OC
+   Modal B: registrar ingreso y asociar números de serie por material
+   Depende de app.js (api, getJson, postJson, putJson, patch, el, esc,
+   fmtMonto, spToast, modalSelectorMarkup, initModalSelector)
+   ===================================================================== */
+(function () {
+  'use strict';
+
+  /* ---------- Estado ---------- */
+  const S = {
+    ordenes: [], proveedores: [], materiales: [],
+    filtro: 'ABIERTA', texto: '',
+    expandidas: new Set(),
+    // formulario de OC
+    editId: null, lineas: [], lineaEdit: null, miMat: null,
+    // ingreso / series
+    oc: null, items: [], stage: {}, sel: null, enviando: false
+  };
+
+  const $ = (id) => document.getElementById(id);
+  const num = (v) => (v === '' || v == null || isNaN(Number(v))) ? 0 : Number(v);
+  const soles = (n) => fmtMonto(n || 0);
+  const modalItem = new bootstrap.Modal($('modalItem'));
+  const modalIngreso = new bootstrap.Modal($('modalIngreso'));
+
+  function hoy() {
+    const d = new Date();
+    const p = (n) => String(n).padStart(2, '0');
+    return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate());
+  }
+  function matPorId(id) { return S.materiales.find(m => m.idMaterial === id); }
+  function mostrarError(box, msg) {
+    box.textContent = msg || '';
+    box.hidden = !msg;
+  }
+
+  /* =================================================================
+     CARGA DE DATOS
+     ================================================================= */
+  async function cargarOrdenes() {
+    S.ordenes = await getJson('/api/almacen/ordenes-compra?incluirCerradas=true') || [];
+    S.ordenes.sort((a, b) => (b.idOrdenCompra || 0) - (a.idOrdenCompra || 0));
+  }
+
+  async function iniciar() {
+    try {
+      const [, proveedores, materiales] = await Promise.all([
+        cargarOrdenes(),
+        getJson('/api/empresa?tipo=PROVEEDOR'),
+        getJson('/api/almacen/materiales')
+      ]);
+      S.proveedores = proveedores || [];
+      S.materiales = (materiales || []).filter(m => m.estado === 'ACTIVO');
+    } catch (e) {
+      $('tablaOcs').innerHTML = '<tr><td colspan="7" class="text-danger p-3">' + esc(e.message) + '</td></tr>';
+      return;
+    }
+
+    // Selector de proveedor (modal de búsqueda ya existente en app.js)
+    $('proveedorHost').innerHTML = modalSelectorMarkup('proveedorSel', 'Buscar y seleccionar proveedor');
+    initModalSelector('proveedorSel', 'proveedor', S.proveedores.map(p => ({
+      value: p.idEmpresa,
+      label: p.razonSocial + ' — RUC ' + p.ruc,
+      meta: p.contactoNombre ? 'Contacto: ' + p.contactoNombre : null
+    })));
+    limpiarProveedor();
+
+    enlazarEventos();
+    renderLista();
+  }
+
+  /* =================================================================
+     VISTA 1 · LISTADO
+     ================================================================= */
+  function resumenOrden(o) {
+    const items = o.items || [];
+    const pedido = items.reduce((s, i) => s + (i.cantidad || 0), 0);
+    const recibido = items.reduce((s, i) => s + Math.min(i.cantidadRecibida || 0, i.cantidad || 0), 0);
+    const total = items.reduce((s, i) => s + (i.cantidad || 0) * (i.precioUnitario || 0), 0);
+    return { pedido, recibido, total, n: items.length };
+  }
+
+  function renderLista() {
+    const q = S.texto.trim().toLowerCase();
+    const lista = S.ordenes.filter(o =>
+      (S.filtro === 'TODAS' || o.estado === S.filtro) &&
+      (!q || [o.codigo, o.proveedor, o.rucProveedor].some(v => v && String(v).toLowerCase().includes(q))));
+
+    if (!lista.length) {
+      $('tablaOcs').innerHTML = '<tr><td colspan="7"><div class="empty-state"><i class="bi bi-inbox"></i>' +
+        '<p class="mb-0">No hay órdenes que coincidan con el filtro.</p></div></td></tr>';
+      return;
+    }
+
+    $('tablaOcs').innerHTML = lista.map(o => {
+      const r = resumenOrden(o);
+      const abierta = o.estado === 'ABIERTA';
+      const abierto = S.expandidas.has(o.idOrdenCompra);
+      const pct = r.pedido ? Math.round(r.recibido * 100 / r.pedido) : 0;
+      const completo = r.pedido > 0 && r.recibido >= r.pedido;
+
+      const avance = r.n
+        ? '<div class="oc-progress"><div class="progress"><div class="progress-bar ' + (completo ? 'bg-success' : '') +
+          '" style="width:' + pct + '%"></div></div><small>' + r.recibido + ' / ' + r.pedido + ' unidades</small></div>'
+        : '<span class="text-muted small">Sin materiales</span>';
+
+      const acciones = abierta
+        ? '<button class="btn btn-sm btn-primary" data-act="ingreso" data-id="' + o.idOrdenCompra + '"' + (completo ? ' disabled' : '') + '>' +
+            '<i class="bi bi-upc-scan"></i> Registrar ingreso</button> ' +
+          '<button class="btn btn-sm btn-outline-secondary" data-act="editar" data-id="' + o.idOrdenCompra + '" title="Editar"><i class="bi bi-pencil"></i></button> ' +
+          '<button class="btn btn-sm btn-outline-danger" data-act="cerrar" data-id="' + o.idOrdenCompra + '" title="Cerrar orden"><i class="bi bi-lock"></i></button>'
+        : '<button class="btn btn-sm btn-outline-success" data-act="reabrir" data-id="' + o.idOrdenCompra + '"><i class="bi bi-unlock"></i> Reabrir</button>';
+
+      const detalle = r.n
+        ? '<table class="table table-sm mb-0 oc-detalle"><thead><tr><th>Material</th><th>Categoría</th>' +
+          '<th class="text-end">Pedido</th><th class="text-end">Recibido</th><th class="text-end">Pendiente</th>' +
+          '<th class="text-end">Precio</th><th class="text-end">Subtotal</th></tr></thead><tbody>' +
+          o.items.map(it => {
+            const rec = it.cantidadRecibida || 0;
+            const pen = Math.max(0, (it.cantidad || 0) - rec);
+            return '<tr><td><strong>' + esc(it.codigoMaterial || '—') + '</strong><div class="small text-muted">' + esc(it.nombreMaterial || '') + '</div></td>' +
+              '<td><span class="badge-cat">' + esc(it.categoria || '—') + '</span></td>' +
+              '<td class="text-end">' + it.cantidad + '</td>' +
+              '<td class="text-end">' + rec + '</td>' +
+              '<td class="text-end ' + (pen ? 'text-warning fw-bold' : 'text-success') + '">' + pen + '</td>' +
+              '<td class="text-end">' + soles(it.precioUnitario) + '</td>' +
+              '<td class="text-end">' + soles((it.precioUnitario || 0) * it.cantidad) + '</td></tr>';
+          }).join('') + '</tbody></table>'
+        : '<p class="text-muted mb-0 small">Esta orden no tiene materiales. Use «Editar» para agregarlos.</p>';
+
+      return '<tr class="oc-row">' +
+        '<td><button class="btn btn-link btn-sm p-0 me-1 oc-toggle" data-act="toggle" data-id="' + o.idOrdenCompra + '" aria-label="Ver detalle">' +
+          '<i class="bi bi-chevron-' + (abierto ? 'down' : 'right') + '"></i></button>' +
+          '<strong>' + esc(o.codigo) + '</strong></td>' +
+        '<td>' + esc(o.proveedor) + '<div class="small text-muted">' + (o.rucProveedor ? 'RUC ' + esc(o.rucProveedor) : 'Sin RUC') + '</div></td>' +
+        '<td>' + esc(o.fechaEmision) + '</td>' +
+        '<td>' + avance + '</td>' +
+        '<td class="text-end">' + soles(r.total) + '</td>' +
+        '<td>' + (abierta ? '<span class="badge bg-success">Abierta</span>' : '<span class="badge bg-secondary">Cerrada</span>') + '</td>' +
+        '<td class="text-end text-nowrap">' + acciones + '</td></tr>' +
+        '<tr class="oc-detalle-row"' + (abierto ? '' : ' hidden') + '><td colspan="7">' + detalle + '</td></tr>';
+    }).join('');
+  }
+
+  async function refrescar() {
+    await cargarOrdenes();
+    renderLista();
+  }
+
+  async function accionOrden(act, id) {
+    try {
+      if (act === 'cerrar') {
+        if (!confirm('¿Cerrar esta orden? Ya no se podrán registrar ingresos contra ella.')) return;
+        await api('/api/almacen/ordenes-compra/' + id, { method: 'DELETE' });
+        spToast('Orden cerrada.', 'success');
+      } else if (act === 'reabrir') {
+        await patch('/api/almacen/ordenes-compra/' + id + '/reabrir');
+        spToast('Orden reabierta.', 'success');
+      }
+      await refrescar();
+    } catch (e) { spToast(e.message, 'danger'); }
+  }
+
+  /* =================================================================
+     VISTA 2 · FORMULARIO DE ORDEN
+     ================================================================= */
+  function limpiarProveedor() {
+    el('proveedorSel').value = '';
+    el('proveedorSelDisplay').value = '';
+  }
+
+  function mostrarVista(nombre) {
+    $('vistaLista').hidden = nombre !== 'lista';
+    $('vistaForm').hidden = nombre !== 'form';
+    window.scrollTo({ top: 0 });
+  }
+
+  function abrirForm(orden) {
+    S.editId = orden ? orden.idOrdenCompra : null;
+    $('tituloOrden').textContent = orden ? 'Editar orden ' + orden.codigo : 'Nueva orden de compra';
+    $('codigoOrden').value = orden ? orden.codigo : '';
+    $('fechaOrden').value = orden ? orden.fechaEmision : hoy();
+    limpiarProveedor();
+    if (orden && orden.idEmpresa) {
+      el('proveedorSel').value = orden.idEmpresa;
+      el('proveedorSelDisplay').value = orden.proveedor + (orden.rucProveedor ? ' — RUC ' + orden.rucProveedor : '');
+    }
+    S.lineas = orden && orden.items ? orden.items.map(it => ({
+      idMaterial: it.idMaterial, cantidad: it.cantidad, precio: it.precioUnitario == null ? '' : it.precioUnitario
+    })) : [];
+    renderLineas();
+    mostrarVista('form');
+    if (!orden) $('codigoOrden').focus();
+  }
+
+  function renderLineas() {
+    if (!S.lineas.length) {
