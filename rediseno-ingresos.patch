+
+  /* =================================================================
+     MODAL B · REGISTRAR INGRESO Y ASOCIAR SERIES
+     ================================================================= */
+  function abrirIngreso(id) {
+    const oc = S.ordenes.find(o => o.idOrdenCompra === id);
+    if (!oc) return;
+    S.oc = oc;
+    S.enviando = false;
+
+    // Agrupa por material (por si hubiera líneas repetidas)
+    const grupos = new Map();
+    (oc.items || []).forEach(it => {
+      const g = grupos.get(it.idMaterial);
+      if (g) g.pedido += it.cantidad || 0;
+      else grupos.set(it.idMaterial, {
+        idMaterial: it.idMaterial, codigo: it.codigoMaterial, nombre: it.nombreMaterial,
+        categoria: it.categoria, pedido: it.cantidad || 0, recibido: it.cantidadRecibida || 0
+      });
+    });
+    S.items = Array.from(grupos.values());
+    S.stage = {};
+    S.items.forEach(g => { S.stage[g.idMaterial] = { series: [], sinSerie: false, cantidad: 0 }; });
+    const primero = S.items.find(g => g.pedido - g.recibido > 0) || S.items[0];
+    S.sel = primero ? primero.idMaterial : null;
+
+    $('ingOc').textContent = oc.codigo;
+    $('ingProv').textContent = oc.proveedor + (oc.rucProveedor ? ' · RUC ' + oc.rucProveedor : '') + ' · Emisión ' + oc.fechaEmision;
+    $('ingVacio').hidden = S.items.length > 0;
+    $('ingCuerpo').hidden = S.items.length === 0;
+    mostrarError($('ingError'), '');
+    renderIngreso();
+    modalIngreso.show();
+  }
+
+  const pendiente = (g) => Math.max(0, g.pedido - g.recibido);
+  function enCola(g) {
+    const st = S.stage[g.idMaterial];
+    return st.sinSerie ? (st.cantidad || 0) : st.series.length;
+  }
+
+  function renderIngreso() {
+    renderIngItems();
+    renderIngPanel();
+    renderIngResumen();
+  }
+
+  function renderIngItems() {
+    $('ingItems').innerHTML = S.items.map(g => {
+      const pen = pendiente(g);
+      const cola = enCola(g);
+      const completo = pen === 0;
+      const lleno = !completo && cola >= pen;
+      const estado = completo
+        ? '<span class="badge bg-success">Completo</span>'
+        : cola > 0
+          ? '<span class="badge ' + (lleno ? 'bg-success' : 'bg-warning text-dark') + '">' + cola + ' / ' + pen + ' por registrar</span>'
+          : '<span class="badge bg-light text-dark border">' + pen + ' pendientes</span>';
+      const pct = g.pedido ? Math.min(100, Math.round((g.recibido + cola) * 100 / g.pedido)) : 0;
+      return '<button type="button" class="ing-item' + (S.sel === g.idMaterial ? ' active' : '') + '" data-id="' + g.idMaterial + '"' + (completo ? ' data-done="1"' : '') + '>' +
+        '<div class="d-flex justify-content-between align-items-start gap-2">' +
+          '<div class="text-start"><strong>' + esc(g.codigo) + '</strong><div class="small text-muted">' + esc(g.nombre) + '</div></div>' +
+          estado + '</div>' +
+        '<div class="progress mt-2"><div class="progress-bar ' + (completo || lleno ? 'bg-success' : '') + '" style="width:' + pct + '%"></div></div>' +
+        '<div class="d-flex justify-content-between small text-muted mt-1"><span>' + esc(g.categoria || '—') + '</span>' +
+          '<span>Pedido ' + g.pedido + ' · Recibido ' + g.recibido + '</span></div></button>';
+    }).join('');
+  }
+
+  function renderIngPanel() {
+    const g = S.items.find(x => x.idMaterial === S.sel);
+    if (!g) { $('ingPanel').innerHTML = ''; return; }
+    const st = S.stage[g.idMaterial];
+    const pen = pendiente(g);
+
+    if (pen === 0) {
+      $('ingPanel').innerHTML = '<div class="empty-state"><i class="bi bi-check-circle text-success"></i>' +
+        '<p class="mb-0"><strong>' + esc(g.codigo) + '</strong> ya fue recibido por completo (' + g.recibido + ' de ' + g.pedido + ').</p></div>';
+      return;
+    }
+
+    const modo = st.sinSerie
+      ? '<div class="row g-2 align-items-end mt-2"><div class="col-sm-6"><label class="form-label small mb-1" for="ingCantidad">Unidades recibidas</label>' +
+        '<input type="number" id="ingCantidad" class="form-control" min="0" max="' + pen + '" value="' + (st.cantidad || '') + '" placeholder="0"/></div>' +
+        '<div class="col-sm-6 small text-muted">Máximo pendiente: <strong>' + pen + '</strong></div></div>'
+      : '<label class="form-label small mt-2 mb-1" for="ingSerieIn">Escanee o escriba un número de serie por línea <span class="text-muted">(Enter para agregar)</span></label>' +
+        '<div class="input-group">' +
+          '<textarea id="ingSerieIn" class="form-control" rows="2" placeholder="SN-0001&#10;SN-0002"></textarea>' +
+          '<button class="btn btn-primary" type="button" data-act="serie-add"><i class="bi bi-plus-lg"></i> Agregar</button>' +
+        '</div>' +
+        '<details class="ing-gen mt-2"><summary>Generar correlativos</summary>' +
+          '<div class="row g-2 mt-1">' +
+            '<div class="col-sm-5"><input id="genPrefijo" class="form-control form-control-sm" placeholder="Prefijo (ej. 7SJ62-)"/></div>' +
+            '<div class="col-sm-3"><input id="genDesde" type="number" min="0" class="form-control form-control-sm" value="1" title="Desde"/></div>' +
+            '<div class="col-sm-2"><input id="genCant" type="number" min="1" max="' + pen + '" class="form-control form-control-sm" value="' + Math.max(1, pen - st.series.length) + '" title="Cantidad"/></div>' +
+            '<div class="col-sm-2 d-grid"><button class="btn btn-outline-primary btn-sm" type="button" data-act="serie-gen">Generar</button></div>' +
+          '</div></details>';
+
+    const lista = st.sinSerie ? '' :
+      '<div class="d-flex justify-content-between align-items-center mt-3 mb-1">' +
+        '<span class="ing-col-title mb-0">Series asociadas (' + st.series.length + ' de ' + pen + ')</span>' +
+        (st.series.length ? '<button class="btn btn-link btn-sm text-danger p-0" type="button" data-act="serie-clear">Quitar todas</button>' : '') +
+      '</div>' +
+      (st.series.length
+        ? '<div class="serie-grid">' + st.series.map((s, i) =>
+            '<span class="serie-chip"><span class="n">' + (i + 1) + '</span>' + esc(s) +
+            '<button type="button" data-act="serie-del" data-i="' + i + '" aria-label="Quitar ' + esc(s) + '">&times;</button></span>').join('') + '</div>'
+        : '<div class="serie-empty">Todavía no hay series. Escanee o escriba la primera.</div>');
+
+    $('ingPanel').innerHTML =
+      '<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">' +
+        '<div><div class="fw-bold">' + esc(g.codigo) + ' <span class="badge-cat ms-1">' + esc(g.categoria || '—') + '</span></div>' +
+        '<div class="small text-muted">' + esc(g.nombre) + '</div></div>' +
+        '<div class="text-end small">Pedido <strong>' + g.pedido + '</strong> · Recibido <strong>' + g.recibido + '</strong> · Pendiente <strong>' + pen + '</strong></div>' +
+      '</div>' +
+      '<div class="form-check form-switch mt-3 mb-0">' +
+        '<input class="form-check-input" type="checkbox" id="ingSinSerie"' + (st.sinSerie ? ' checked' : '') + '/>' +
+        '<label class="form-check-label small" for="ingSinSerie">Este material no maneja serie por unidad (ej. cable o canaleta por metro): ingresar solo cantidad</label>' +
+      '</div>' + modo + lista;
+
+    const foco = $('ingSerieIn') || $('ingCantidad');
+    if (foco) foco.focus();
+  }
+
+  function renderIngResumen() {
+    const conCola = S.items.filter(g => enCola(g) > 0);
+    const total = conCola.reduce((s, g) => s + enCola(g), 0);
+    $('ingResumen').textContent = total
+      ? total + ' unidad(es) en ' + conCola.length + ' material(es) listas para registrar'
+      : 'Sin series por registrar';
+    $('ingGuardar').disabled = total === 0 || S.enviando;
+  }
+
+  // Agrega series (texto con varias líneas) respetando pendiente y duplicados
+  function agregarSeries(texto) {
+    const g = S.items.find(x => x.idMaterial === S.sel);
+    if (!g) return;
+    const st = S.stage[g.idMaterial];
+    const pen = pendiente(g);
+    const entradas = String(texto).split(/[\n\r,;\t]+/).map(s => s.trim()).filter(Boolean);
+    if (!entradas.length) return;
+
+    const existentes = new Set();
+    S.items.forEach(x => S.stage[x.idMaterial].series.forEach(s => existentes.add(s.toLowerCase())));
+    const duplicadas = [], largas = [];
+    let sobrantes = 0;
+    entradas.forEach(s => {
+      if (s.length > 100) { largas.push(s.slice(0, 12) + '…'); return; }
+      if (existentes.has(s.toLowerCase())) { duplicadas.push(s); return; }
+      if (st.series.length >= pen) { sobrantes++; return; }
+      st.series.push(s);
+      existentes.add(s.toLowerCase());
+    });
+    if (duplicadas.length) spToast('Serie repetida, no se agregó: ' + duplicadas.slice(0, 3).join(', ') + (duplicadas.length > 3 ? '…' : ''), 'warning');
+    if (largas.length) spToast('Serie demasiado larga (máx. 100 caracteres): ' + largas.join(', '), 'warning');
+    if (sobrantes) spToast('Solo quedaban ' + pen + ' unidades pendientes; se ignoraron ' + sobrantes + ' serie(s).', 'warning');
+    mostrarError($('ingError'), '');
+    renderIngreso();
+  }
+
+  function generarSeries() {
+    const g = S.items.find(x => x.idMaterial === S.sel);
+    const prefijo = $('genPrefijo').value.trim();
+    const desde = parseInt($('genDesde').value, 10);
+    const cant = parseInt($('genCant').value, 10);
+    if (isNaN(desde) || !cant || cant < 1) { spToast('Indique el número inicial y la cantidad a generar.', 'warning'); return; }
+    const ancho = Math.max(4, String(desde + cant - 1).length);
+    const lista = [];
+    for (let i = 0; i < cant; i++) lista.push(prefijo + String(desde + i).padStart(ancho, '0'));
+    agregarSeries(lista.join('\n'));
+  }
+
+  async function registrarIngreso() {
+    if (S.enviando) return;
+    const items = [];
+    S.items.forEach(g => {
+      const st = S.stage[g.idMaterial];
+      if (st.sinSerie) { if (st.cantidad > 0) items.push({ codigo: g.codigo, cantidad: st.cantidad }); }
+      else if (st.series.length) items.push({ codigo: g.codigo, numeroSeries: st.series.slice() });
+    });
+    if (!items.length) return;
+
+    S.enviando = true;
+    $('ingGuardar').disabled = true;
+    $('ingGuardar').innerHTML = '<span class="spinner-border spinner-border-sm"></span> Registrando…';
+    mostrarError($('ingError'), '');
+    try {
+      const r = await postJson('/api/almacen/ingresos', { idOrdenCompra: S.oc.idOrdenCompra, items });
+      if (!r) return;
+      if (r.exito === false) {
+        mostrarError($('ingError'), (r.mensaje || 'No se pudo registrar el ingreso.') +
+          ((r.materialesNoRegistrados || []).length ? ' Materiales no registrados: ' + r.materialesNoRegistrados.join(', ') : ''));
+        return;
+      }
+      spToast((r.detalle || []).join(' · ') || r.mensaje || 'Ingreso registrado.', 'success');
+      modalIngreso.hide();
+      await refrescar();
+    } catch (e) {
+      mostrarError($('ingError'), e.message);
+    } finally {
+      S.enviando = false;
+      $('ingGuardar').innerHTML = '<i class="bi bi-check2-circle"></i> Registrar ingreso';
+      renderIngResumen();
+    }
+  }
+
+  /* =================================================================
+     EVENTOS
+     ================================================================= */
+  function enlazarEventos() {
+    // Lista
+    $('btnNueva').onclick = () => abrirForm(null);
+    $('ocBuscar').addEventListener('input', e => { S.texto = e.target.value; renderLista(); });
+    $('ocFiltro').addEventListener('click', e => {
+      const b = e.target.closest('button[data-f]');
+      if (!b) return;
+      S.filtro = b.dataset.f;
+      $('ocFiltro').querySelectorAll('button').forEach(x => x.classList.toggle('active', x === b));
+      renderLista();
+    });
