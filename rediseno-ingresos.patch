+  }
+
+  function guardarItem() {
+    const cant = parseInt($('miCant').value, 10);
+    if (!S.miMat) return mostrarError($('miError'), 'Seleccione un material.');
+    if (!cant || cant <= 0) return mostrarError($('miError'), 'Ingrese una cantidad mayor que cero.');
+    const precio = $('miPrecio').value;
+    if (precio !== '' && Number(precio) < 0) return mostrarError($('miError'), 'El precio no puede ser negativo.');
+    const linea = { idMaterial: S.miMat, cantidad: cant, precio: precio === '' ? '' : Number(precio) };
