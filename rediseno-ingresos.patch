+      const b = e.target.closest('[data-act]');
+      if (!b || b.disabled) return;
+      const id = parseInt(b.dataset.id, 10);
+      switch (b.dataset.act) {
+        case 'toggle':
+          S.expandidas.has(id) ? S.expandidas.delete(id) : S.expandidas.add(id);
+          renderLista(); break;
+        case 'ingreso': abrirIngreso(id); break;
+        case 'editar': abrirForm(S.ordenes.find(o => o.idOrdenCompra === id)); break;
+        default: accionOrden(b.dataset.act, id);
+      }
+    });
+
+    // Formulario de OC
+    $('btnVolver').onclick = () => mostrarVista('lista');
+    $('cancelarOrden').onclick = () => mostrarVista('lista');
+    $('guardarOrden').onclick = guardarOrden;
+    $('btnAddMaterial').onclick = () => abrirModalItem(null);
+    $('lineasOrden').addEventListener('click', e => {
+      const b = e.target.closest('[data-act]');
+      if (!b) return;
+      const i = parseInt(b.dataset.i, 10);
+      if (b.dataset.act === 'add-vacio') abrirModalItem(null);
+      else if (b.dataset.act === 'edit-linea') abrirModalItem(i);
+      else if (b.dataset.act === 'del-linea') { S.lineas.splice(i, 1); renderLineas(); }
+    });
+
+    // Modal A
+    $('miBuscar').addEventListener('input', renderMiLista);
+    $('miLista').addEventListener('click', e => {
+      const b = e.target.closest('.mat-item');
+      if (!b || b.disabled) return;
+      S.miMat = parseInt(b.dataset.id, 10);
+      const m = matPorId(S.miMat);
+      if (m && $('miPrecio').value === '' && m.precioUnitario != null) $('miPrecio').value = m.precioUnitario;
+      renderMiLista();
+      renderMiSel();
+      mostrarError($('miError'), '');
+      $('miCant').focus();
+    });
+    $('miCant').addEventListener('input', actualizarSubtotal);
+    $('miPrecio').addEventListener('input', actualizarSubtotal);
+    $('miCant').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); guardarItem(); } });
+    $('miPrecio').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); guardarItem(); } });
+    $('miGuardar').onclick = guardarItem;
+    $('modalItem').addEventListener('shown.bs.modal', () => $('miBuscar').focus());
+
+    // Modal B
+    $('ingItems').addEventListener('click', e => {
+      const b = e.target.closest('.ing-item');
+      if (!b) return;
+      S.sel = parseInt(b.dataset.id, 10);
+      renderIngreso();
+    });
+    $('ingPanel').addEventListener('click', e => {
+      const b = e.target.closest('[data-act]');
+      if (!b) return;
+      const st = S.stage[S.sel];
+      switch (b.dataset.act) {
+        case 'serie-add': { const t = $('ingSerieIn'); agregarSeries(t.value); t.value = ''; break; }
+        case 'serie-gen': generarSeries(); break;
+        case 'serie-del': st.series.splice(parseInt(b.dataset.i, 10), 1); renderIngreso(); break;
+        case 'serie-clear': st.series = []; renderIngreso(); break;
+      }
+    });
+    $('ingPanel').addEventListener('keydown', e => {
+      if (e.target.id === 'ingSerieIn' && e.key === 'Enter' && !e.shiftKey) {
+        e.preventDefault();
+        agregarSeries(e.target.value);
+        e.target.value = '';
+      }
